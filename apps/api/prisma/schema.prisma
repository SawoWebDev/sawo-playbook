// SAWO Playbook schema — see SAWO-Playbook-System-Build-Plan-FINAL.md §6 / §7.
// Conventions:
//  * Every tenant-owned table carries organization_id (Invariant #1), including
//    child tables (sop_version, sop_step, ...) so every query can be tenant-scoped
//    directly without joins (Invariant #10, §8).
//  * Constraints Prisma cannot express (partial unique index, CHECKs, triggers)
//    live in hand-written SQL inside the migrations.

generator client {
  provider      = "prisma-client-js"
  binaryTargets = ["native", "debian-openssl-3.0.x"]
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ─────────────────────────── Enums ───────────────────────────

enum OrganizationStatus {
  active
  suspended
  pending_deletion
  deleted
}

enum UserStatus {
  invited
  active
  suspended
  removed
}

enum OrgRole {
  OWNER
  ADMIN
  EDITOR
  APPROVER
  TRAINER
  OPERATOR
  PRE_APPROVER
}

/// Which review stage a decision belongs to (SOP versions and kanban revisions).
enum ApprovalStage {
  pre
  final

  @@map("approval_stage")
}

enum KanbanRevisionState {
  DRAFT
  PENDING_PRE_APPROVAL
  PRE_APPROVED
  APPROVED
  PUBLISHED
  DISCARDED

  @@map("kanban_revision_state")
}

enum SopType {
  standard
  advanced
  video
  document
}

enum SopStatus {
  draft
  pending_approval
  approved
  published
  archived
}

enum VersionLifecycleState {
  DRAFT
  PENDING_PRE_APPROVAL
  PENDING_APPROVAL
  APPROVED
  PUBLISHED
  ABANDONED
}

enum ApprovalDecision {
  approved
  rejected
}

enum MediaType {
  image
  video
  pdf
  document
}

enum MediaLifecycleState {
  uploaded
  attached
  referenced
  orphaned
  soft_deleted
  purged
}

enum KanbanOrderingType {
  url
  sop
  email
}

enum ChecklistStatus {
  in_progress
  completed
  abandoned
}

enum ChecklistResult {
  ok
  not_ok
  n_a    @map("n/a")
}

enum InvitationStatus {
  pending
  accepted
  revoked
  expired
}

// ─────────────────────── Tenancy (§6.1) ───────────────────────

model Organization {
  id                   String             @id @default(uuid()) @db.Uuid
  name                 String
  status               OrganizationStatus @default(active)
  deletionRequestedAt  DateTime?          @map("deletion_requested_at")
  deletionScheduledFor DateTime?          @map("deletion_scheduled_for")
  createdAt            DateTime           @default(now()) @map("created_at")
  updatedAt            DateTime           @updatedAt @map("updated_at")

  settings        OrganizationSettings?
  users           User[]
  folders         Folder[]
  sops            Sop[]
  sopVersions     SopVersion[]
  mediaAssets     MediaAsset[]
  kanbans         Kanban[]
  activityEvents  ActivityEvent[]
  auditLogs       AuditLog[]
  invitations     Invitation[]
  userGroups      UserGroup[]
  kanbanRevisions KanbanRevision[]

  @@map("organization")
}

// §6.1a
model OrganizationSettings {
  organizationId    String       @id @map("organization_id") @db.Uuid
  /// When false, "Finish & Save" publishes a draft directly (no approval workflow).
  approvalRequired  Boolean      @default(false) @map("approval_required")
  approvalQuorum    Int          @default(3) @map("approval_quorum")
  allowSelfApproval Boolean      @default(false) @map("allow_self_approval")
  publicSopViewing  Boolean      @default(false) @map("public_sop_viewing")
  /// Admin-configured permissions per role: { "EDITOR": ["kanban.view", ...] }. Missing roles use the defaults in common/permissions.ts.
  rolePermissions   Json?        @map("role_permissions")
  /// Sidebar menu customisation: { "order": ["/sops", ...], "hidden": ["/skills"] }. Null = the built-in menu. Only the "Work" and "Review" items are configurable.
  navConfig         Json?        @map("nav_config")
  updatedAt         DateTime     @default(now()) @updatedAt @map("updated_at")
  organization      Organization @relation(fields: [organizationId], references: [id])

  @@map("organization_settings")
}

// ─────────────────────── Users (§7.1) ───────────────────────

model User {
  id                  String     @id @default(uuid()) @db.Uuid
  organizationId      String     @map("organization_id") @db.Uuid
  email               String     @unique // multi-org membership deferred (§18)
  name                String
  status              UserStatus @default(invited)
  passwordHash        String?    @map("password_hash")
  ssoProviderId       String?    @map("sso_provider_id")
  orgRole             OrgRole    @map("org_role")
  siteScope           String[]   @default([]) @map("site_scope") // NOT enforced in MVP (§6.10)
  folderScope         String[]   @default([]) @map("folder_scope") // NOT enforced in MVP (§6.10)
  mfaEnabled          Boolean    @default(false) @map("mfa_enabled")
  /// AES-256-GCM encrypted TOTP secrets (key: MFA_ENCRYPTION_KEY)
  mfaSecretEnc        String?    @map("mfa_secret_enc")
  mfaPendingSecretEnc String?    @map("mfa_pending_secret_enc")
  /// Last accepted TOTP time-step — prevents code replay
  mfaLastStep         Int?       @map("mfa_last_step")
  // Bumped on password reset / role change / removal; embedded in access JWTs
  // so outstanding access tokens are rejected immediately (§7.3 rule 7).
  tokenVersion        Int        @default(0) @map("token_version")
  /// Set when an Admin created the account with a temporary password. Every route except the password change and
  /// /auth/me is refused until the user sets their own password. Cleared by a successful password change.
  passwordMustChange  Boolean    @default(false) @map("password_must_change")
  failedLogins        Int        @default(0) @map("failed_logins")
  lockedUntil         DateTime?  @map("locked_until")
  lastLoginAt         DateTime?  @map("last_login_at")
  createdById         String?    @map("created_by") @db.Uuid
  createdAt           DateTime   @default(now()) @map("created_at")
  updatedAt           DateTime   @updatedAt @map("updated_at")

  organization     Organization         @relation(fields: [organizationId], references: [id])
  createdBy        User?                @relation("UserCreatedBy", fields: [createdById], references: [id])
  created          User[]               @relation("UserCreatedBy")
  refreshTokens    RefreshToken[]
  passwordResets   PasswordResetToken[]
  groupMemberships GroupMember[]

  /// Target for the composite foreign keys from group membership (see GroupMember).
  @@unique([id, organizationId], map: "app_user_id_organization_id_key")
  @@index([organizationId])
  @@map("app_user")
}

// ─────────────────────── Groups (approval routing) ───────────────────────

/// Organisational groups (Marketing, Safety, …). Used only to scope approval routing;
/// content (SOPs, kanbans) does not belong to a group.
model UserGroup {
  id             String   @id @default(uuid()) @db.Uuid
  organizationId String   @map("organization_id") @db.Uuid
  name           String
  createdAt      DateTime @default(now()) @map("created_at")
  updatedAt      DateTime @updatedAt @map("updated_at")

  organization Organization  @relation(fields: [organizationId], references: [id])
  members      GroupMember[]

  @@unique([organizationId, name])
  /// Target for GroupMember's composite foreign key: a membership must reference a group of its own organisation.
  @@unique([id, organizationId], map: "user_group_id_organization_id_key")
  @@map("user_group")
}

model GroupMember {
  groupId        String   @map("group_id") @db.Uuid
  userId         String   @map("user_id") @db.Uuid
  organizationId String   @map("organization_id") @db.Uuid
  createdAt      DateTime @default(now()) @map("created_at")

  /// Composite foreign keys (group and user must belong to the membership's organisation). Named as in migration 20261006000100.
  group UserGroup @relation(fields: [groupId, organizationId], references: [id, organizationId], onDelete: Cascade, map: "user_group_member_group_same_org_fkey")
  user  User      @relation(fields: [userId, organizationId], references: [id, organizationId], map: "user_group_member_user_same_org_fkey")

  @@id([groupId, userId])
  @@index([organizationId])
  @@index([userId])
  @@map("user_group_member")
}

// §7.4 — refresh tokens stored as hashes, grouped in rotation families.
model RefreshToken {
  id           String    @id @default(uuid()) @db.Uuid
  userId       String    @map("user_id") @db.Uuid
  familyId     String    @map("family_id") @db.Uuid
  tokenHash    String    @unique @map("token_hash")
  expiresAt    DateTime  @map("expires_at")
  rotatedAt    DateTime? @map("rotated_at")
  revokedAt    DateTime? @map("revoked_at")
  revokeReason String?   @map("revoke_reason")
  createdAt    DateTime  @default(now()) @map("created_at")
  userAgent    String?   @map("user_agent")
  ip           String?

  user User @relation(fields: [userId], references: [id])

  @@index([familyId])
  @@index([userId])
  @@map("refresh_token")
}

model PasswordResetToken {
  id        String    @id @default(uuid()) @db.Uuid
  userId    String    @map("user_id") @db.Uuid
  tokenHash String    @unique @map("token_hash")
  expiresAt DateTime  @map("expires_at")
  usedAt    DateTime? @map("used_at")
  createdAt DateTime  @default(now()) @map("created_at")

  user User @relation(fields: [userId], references: [id])

  @@index([userId])
  @@map("password_reset_token")
}

model Invitation {
  id             String           @id @default(uuid()) @db.Uuid
  organizationId String           @map("organization_id") @db.Uuid
  email          String
  orgRole        OrgRole          @map("org_role")
  /// Groups the invitee joins on acceptance (validated when invited; re-checked on accept).
  groupIds       String[]         @default([]) @map("group_ids") @db.Uuid
  tokenHash      String           @unique @map("token_hash")
  status         InvitationStatus @default(pending)
  invitedById    String           @map("invited_by") @db.Uuid
  userId         String?          @map("user_id") @db.Uuid
  expiresAt      DateTime         @map("expires_at")
  acceptedAt     DateTime?        @map("accepted_at")
  createdAt      DateTime         @default(now()) @map("created_at")

  organization Organization @relation(fields: [organizationId], references: [id])

  @@index([organizationId])
  @@map("invitation")
}

// ─────────────────────── Folders (Phase 5 behaviour) ───────────────────────

model Folder {
  id             String    @id @default(uuid()) @db.Uuid
  organizationId String    @map("organization_id") @db.Uuid
  parentId       String?   @map("parent_id") @db.Uuid
  name           String
  createdById    String    @map("created_by") @db.Uuid
  createdAt      DateTime  @default(now()) @map("created_at")
  deletedAt      DateTime? @map("deleted_at")
  deletedById    String?   @map("deleted_by") @db.Uuid

  organization Organization @relation(fields: [organizationId], references: [id])
  parent       Folder?      @relation("FolderTree", fields: [parentId], references: [id])
  children     Folder[]     @relation("FolderTree")
  sops         Sop[]

  @@index([organizationId, parentId])
  @@map("folder")
}

// ─────────────────────── SOP (§6.2) ───────────────────────

model Sop {
  id                        String                   @id @default(uuid()) @db.Uuid
  organizationId            String                   @map("organization_id") @db.Uuid
  referenceNo               String                   @map("reference_no")
  name                      String
  type                      SopType                  @default(standard)
  folderId                  String?                  @map("folder_id") @db.Uuid
  qrPublicToken             String                   @unique @map("qr_public_token")
  currentPublishedVersionId String?                  @unique @map("current_published_version_id") @db.Uuid
  latestDraftVersionId      String?                  @unique @map("latest_draft_version_id") @db.Uuid
  status                    SopStatus                @default(draft) // DERIVED (Invariant #18)
  archivedAt                DateTime?                @map("archived_at")
  createdById               String                   @map("created_by") @db.Uuid
  createdAt                 DateTime                 @default(now()) @map("created_at")
  updatedAt                 DateTime                 @updatedAt @map("updated_at")
  deletedAt                 DateTime?                @map("deleted_at")
  deletedById               String?                  @map("deleted_by") @db.Uuid
  /// FTS (§14): name + reference_no + folder name; maintained by trigger
  searchTsv                 Unsupported("tsvector")? @map("search_tsv")

  organization            Organization      @relation(fields: [organizationId], references: [id])
  folder                  Folder?           @relation(fields: [folderId], references: [id])
  versions                SopVersion[]      @relation("SopVersions")
  currentPublishedVersion SopVersion?       @relation("SopCurrentPublished", fields: [currentPublishedVersionId], references: [id])
  latestDraftVersion      SopVersion?       @relation("SopLatestDraft", fields: [latestDraftVersionId], references: [id])
  linkedFromSteps         SopStep[]         @relation("StepLinkedSop")
  kanbansOrdering         Kanban[]
  skillAssessments        SkillAssessment[]
  skillRecords            SkillRecord[]

  @@unique([organizationId, referenceNo])
  @@index([organizationId, status])
  @@map("sop")
}

// §6.3 — immutable once PUBLISHED
model SopVersion {
  id                   String                   @id @default(uuid()) @db.Uuid
  organizationId       String                   @map("organization_id") @db.Uuid
  sopId                String                   @map("sop_id") @db.Uuid
  versionSequence      Int                      @map("version_sequence")
  config               Json                     @default("{\"cover_sheet\":false,\"collaborate\":false,\"checklist_sop\":false,\"key_points_enabled\":false}")
  lifecycleState       VersionLifecycleState    @default(DRAFT) @map("lifecycle_state")
  currentApprovalRound Int                      @default(1) @map("current_approval_round")
  changeSummary        String?                  @map("change_summary")
  createdById          String                   @map("created_by") @db.Uuid
  createdAt            DateTime                 @default(now()) @map("created_at")
  submittedById        String?                  @map("submitted_by") @db.Uuid
  submittedAt          DateTime?                @map("submitted_at")
  approvedAt           DateTime?                @map("approved_at")
  publishedById        String?                  @map("published_by") @db.Uuid
  publishedAt          DateTime?                @map("published_at")
  pdfAssetId           String?                  @map("pdf_asset_id") @db.Uuid
  /// Groups of the submitter at submission time; scope of who may pre-approve / approve (empty = organisation-wide).
  routingGroupIds      String[]                 @default([]) @map("routing_group_ids") @db.Uuid
  /// FTS (§14): step titles + descriptions; maintained by trigger on sop_step
  contentTsv           Unsupported("tsvector")? @map("content_tsv")

  organization         Organization          @relation(fields: [organizationId], references: [id])
  sop                  Sop                   @relation("SopVersions", fields: [sopId], references: [id])
  currentPublishedOf   Sop?                  @relation("SopCurrentPublished")
  latestDraftOf        Sop?                  @relation("SopLatestDraft")
  pdfAsset             MediaAsset?           @relation("VersionPdf", fields: [pdfAssetId], references: [id])
  steps                SopStep[]             @relation("VersionSteps")
  approvals            SopVersionApproval[]
  linkedFromSteps      SopStep[]             @relation("StepLinkedSopVersion")
  checklistSubmissions ChecklistSubmission[]
  skillAssessments     SkillAssessment[]
  skillRecords         SkillRecord[]

  @@unique([sopId, versionSequence])
  @@index([organizationId])
  // Invariant #19 partial unique index is defined in migration SQL.
  @@map("sop_version")
}

// §6.4 — round-aware approvals
model SopVersionApproval {
  id             String           @id @default(uuid()) @db.Uuid
  organizationId String           @map("organization_id") @db.Uuid
  sopVersionId   String           @map("sop_version_id") @db.Uuid
  approvalRound  Int              @map("approval_round")
  approverId     String           @map("approver_id") @db.Uuid
  stage          ApprovalStage    @default(final)
  decision       ApprovalDecision
  comment        String?
  createdAt      DateTime         @default(now()) @map("created_at")

  sopVersion SopVersion @relation(fields: [sopVersionId], references: [id])

  @@unique([sopVersionId, approvalRound, approverId, stage])
  @@index([organizationId])
  @@map("sop_version_approval")
}

// §6.5
model SopStep {
  id                 String  @id @default(uuid()) @db.Uuid
  organizationId     String  @map("organization_id") @db.Uuid
  sopVersionId       String  @map("sop_version_id") @db.Uuid
  order              Int
  title              String?
  description        String  @default("")
  isTextOnly         Boolean @default(false) @map("is_text_only")
  isCritical         Boolean @default(false) @map("is_critical")
  usesOkNotokMedia   Boolean @default(false) @map("uses_ok_notok_media")
  linkedSopId        String? @map("linked_sop_id") @db.Uuid
  linkedSopVersionId String? @map("linked_sop_version_id") @db.Uuid
  plannedTimeSeconds Int     @default(0) @map("planned_time_seconds")

  sopVersion         SopVersion          @relation("VersionSteps", fields: [sopVersionId], references: [id])
  linkedSop          Sop?                @relation("StepLinkedSop", fields: [linkedSopId], references: [id])
  linkedSopVersion   SopVersion?         @relation("StepLinkedSopVersion", fields: [linkedSopVersionId], references: [id])
  media              SopStepMedia[]
  checklistResponses ChecklistResponse[]

  @@unique([sopVersionId, order])
  @@index([organizationId])
  @@map("sop_step")
}

// ─────────────────────── Media (§6.6 / §6.6a) ───────────────────────

model MediaAsset {
  id               String              @id @default(uuid()) @db.Uuid
  organizationId   String              @map("organization_id") @db.Uuid
  type             MediaType
  storageKey       String              @unique @map("storage_key")
  originalFilename String              @map("original_filename")
  mimeType         String              @map("mime_type")
  sizeBytes        BigInt              @map("size_bytes")
  checksum         String?
  width            Int?
  height           Int?
  durationSeconds  Float?              @map("duration_seconds")
  lifecycleState   MediaLifecycleState @default(uploaded) @map("lifecycle_state")
  orphanedAt       DateTime?           @map("orphaned_at")
  createdById      String              @map("created_by") @db.Uuid
  createdAt        DateTime            @default(now()) @map("created_at")
  deletedAt        DateTime?           @map("deleted_at")

  organization       Organization        @relation(fields: [organizationId], references: [id])
  stepMedia          SopStepMedia[]
  kanbanMedia        KanbanMedia[]
  versionPdfs        SopVersion[]        @relation("VersionPdf")
  kanbanPictures     Kanban[]            @relation("KanbanPicture")
  checklistResponses ChecklistResponse[]

  @@index([organizationId, lifecycleState])
  @@map("media_asset")
}

model SopStepMedia {
  sopStepId    String @map("sop_step_id") @db.Uuid
  mediaAssetId String @map("media_asset_id") @db.Uuid
  displayOrder Int    @default(0) @map("display_order")

  sopStep    SopStep    @relation(fields: [sopStepId], references: [id])
  mediaAsset MediaAsset @relation(fields: [mediaAssetId], references: [id])

  @@id([sopStepId, mediaAssetId])
  @@index([mediaAssetId])
  @@map("sop_step_media")
}

// ─────────────────────── Kanbans (§6.7) ───────────────────────

model Kanban {
  id              String                   @id @default(uuid()) @db.Uuid
  organizationId  String                   @map("organization_id") @db.Uuid
  partCode        String                   @map("part_code")
  partDescription String?                  @map("part_description")
  pictureAssetId  String?                  @map("picture_asset_id") @db.Uuid
  supplier        String?
  supplierPartNo  String?                  @map("supplier_part_no")
  usedFor         String?                  @map("used_for")
  orderWhen       String?                  @map("order_when")
  orderQty        String?                  @map("order_qty")
  deliveryTime    String?                  @map("delivery_time")
  location        String?
  price           Decimal?                 @db.Decimal(12, 2)
  carriage        Decimal?                 @db.Decimal(12, 2)
  customField1    String?                  @map("custom_field_1")
  customField2    String?                  @map("custom_field_2")
  orderingType    KanbanOrderingType       @map("ordering_type")
  orderingUrl     String?                  @map("ordering_url")
  orderingSopId   String?                  @map("ordering_sop_id") @db.Uuid
  orderingEmail   String?                  @map("ordering_email")
  tag             String?
  color           String?
  barcode         String?
  template        String                   @default("01")
  createdById     String                   @map("created_by") @db.Uuid
  createdAt       DateTime                 @default(now()) @map("created_at")
  updatedAt       DateTime                 @updatedAt @map("updated_at")
  deletedAt       DateTime?                @map("deleted_at")
  /// FTS (§14): generated column (part code, description, supplier, supplier part no, used for, tag)
  searchTsv       Unsupported("tsvector")? @map("search_tsv")

  organization Organization     @relation(fields: [organizationId], references: [id])
  picture      MediaAsset?      @relation("KanbanPicture", fields: [pictureAssetId], references: [id])
  orderingSop  Sop?             @relation(fields: [orderingSopId], references: [id])
  media        KanbanMedia[]
  revisions    KanbanRevision[]

  // CHECK constraint on ordering_* fields defined in migration SQL.
  @@index([organizationId])
  @@map("kanban")
}

model KanbanMedia {
  kanbanId     String @map("kanban_id") @db.Uuid
  mediaAssetId String @map("media_asset_id") @db.Uuid

  kanban     Kanban     @relation(fields: [kanbanId], references: [id])
  mediaAsset MediaAsset @relation(fields: [mediaAssetId], references: [id])

  @@id([kanbanId, mediaAssetId])
  @@index([mediaAssetId])
  @@map("kanban_media")
}

// ─────────────────────── Skills (§6.8) ───────────────────────

model TrainerAssignment {
  organizationId String   @map("organization_id") @db.Uuid
  trainerId      String   @map("trainer_id") @db.Uuid
  associateId    String   @map("associate_id") @db.Uuid
  assignedById   String   @map("assigned_by") @db.Uuid
  createdAt      DateTime @default(now()) @map("created_at")

  @@id([trainerId, associateId])
  @@index([organizationId])
  @@map("trainer_assignment")
}

model SkillAssessment {
  id             String   @id @default(uuid()) @db.Uuid
  organizationId String   @map("organization_id") @db.Uuid
  associateId    String   @map("associate_id") @db.Uuid
  sopId          String   @map("sop_id") @db.Uuid
  sopVersionId   String   @map("sop_version_id") @db.Uuid
  level          Int // 0-4, CHECK in migration SQL
  trainerId      String   @map("trainer_id") @db.Uuid
  assessedAt     DateTime @default(now()) @map("assessed_at")
  notes          String?

  sop           Sop          @relation(fields: [sopId], references: [id])
  sopVersion    SopVersion   @relation(fields: [sopVersionId], references: [id])
  currentRecord SkillRecord?

  @@index([organizationId, associateId, sopId])
  @@map("skill_assessment")
}

model SkillRecord {
  organizationId      String   @map("organization_id") @db.Uuid
  associateId         String   @map("associate_id") @db.Uuid
  sopId               String   @map("sop_id") @db.Uuid
  currentLevel        Int      @map("current_level")
  currentSopVersionId String   @map("current_sop_version_id") @db.Uuid
  lastAssessmentId    String   @unique @map("last_assessment_id") @db.Uuid
  updatedAt           DateTime @default(now()) @updatedAt @map("updated_at")

  sop            Sop             @relation(fields: [sopId], references: [id])
  sopVersion     SopVersion      @relation(fields: [currentSopVersionId], references: [id])
  lastAssessment SkillAssessment @relation(fields: [lastAssessmentId], references: [id])

  @@id([associateId, sopId])
  @@index([organizationId])
  @@map("skill_record")
}

// ─────────────────────── Checklists (§6.11) ───────────────────────

model ChecklistSubmission {
  id             String          @id @default(uuid()) @db.Uuid
  organizationId String          @map("organization_id") @db.Uuid
  sopVersionId   String          @map("sop_version_id") @db.Uuid
  operatorId     String          @map("operator_id") @db.Uuid
  startedAt      DateTime        @default(now()) @map("started_at")
  completedAt    DateTime?       @map("completed_at")
  status         ChecklistStatus @default(in_progress)

  sopVersion SopVersion          @relation(fields: [sopVersionId], references: [id])
  responses  ChecklistResponse[]

  @@index([organizationId])
  @@map("checklist_submission")
}

model ChecklistResponse {
  id           String           @id @default(uuid()) @db.Uuid
  submissionId String           @map("submission_id") @db.Uuid
  stepId       String           @map("step_id") @db.Uuid
  value        String?
  result       ChecklistResult?
  comment      String?
  mediaAssetId String?          @map("media_asset_id") @db.Uuid
  recordedAt   DateTime         @default(now()) @map("recorded_at")

  submission ChecklistSubmission @relation(fields: [submissionId], references: [id])
  step       SopStep             @relation(fields: [stepId], references: [id])
  mediaAsset MediaAsset?         @relation(fields: [mediaAssetId], references: [id])

  @@unique([submissionId, stepId])
  @@map("checklist_response")
}

// ─────────────────────── Events (§6.9) ───────────────────────

model ActivityEvent {
  id             String   @id @default(uuid()) @db.Uuid
  organizationId String   @map("organization_id") @db.Uuid
  actorId        String?  @map("actor_id") @db.Uuid
  eventType      String   @map("event_type")
  entityType     String?  @map("entity_type")
  entityId       String?  @map("entity_id")
  metadata       Json     @default("{}")
  occurredAt     DateTime @default(now()) @map("occurred_at")

  organization Organization @relation(fields: [organizationId], references: [id])

  @@index([organizationId, eventType, occurredAt])
  @@map("activity_event")
}

// Immutable (UPDATE/DELETE blocked by trigger in migration SQL — Invariant #11)
model AuditLog {
  id             String   @id @default(uuid()) @db.Uuid
  organizationId String?  @map("organization_id") @db.Uuid
  actorId        String?  @map("actor_id") @db.Uuid
  action         String
  entityType     String?  @map("entity_type")
  entityId       String?  @map("entity_id")
  metadata       Json     @default("{}")
  ip             String?
  userAgent      String?  @map("user_agent")
  occurredAt     DateTime @default(now()) @map("occurred_at")

  organization Organization? @relation(fields: [organizationId], references: [id])

  @@index([organizationId, occurredAt])
  @@index([action])
  @@map("audit_log")
}

// ─────────────────────── Kanban revisions (approval workflow) ───────────────────────

/// A proposed change to a kanban (or a new card). The live `kanban` row is untouched until PUBLISHED.
/// At most one open revision per live kanban (partial unique index in the migration).
model KanbanRevision {
  id              String              @id @default(uuid()) @db.Uuid
  organizationId  String              @map("organization_id") @db.Uuid
  kanbanId        String?             @map("kanban_id") @db.Uuid
  state           KanbanRevisionState @default(DRAFT)
  /// Proposed card fields: partCode, partDescription, …, ordering*, pictureAssetId, mediaAssetIds.
  payload         Json
  routingGroupIds String[]            @default([]) @map("routing_group_ids") @db.Uuid
  createdById     String              @map("created_by") @db.Uuid
  updatedById     String              @map("updated_by") @db.Uuid
  submittedById   String?             @map("submitted_by") @db.Uuid
  submittedAt     DateTime?           @map("submitted_at")
  preApprovedById String?             @map("pre_approved_by") @db.Uuid
  preApprovedAt   DateTime?           @map("pre_approved_at")
  approvedById    String?             @map("approved_by") @db.Uuid
  approvedAt      DateTime?           @map("approved_at")
  publishedById   String?             @map("published_by") @db.Uuid
  publishedAt     DateTime?           @map("published_at")
  /// Last rejection / discard comment; the reason shown to the editor when the revision returns to DRAFT.
  lastComment     String?             @map("last_comment")
  lastCommentById String?             @map("last_comment_by") @db.Uuid
  createdAt       DateTime            @default(now()) @map("created_at")
  updatedAt       DateTime            @updatedAt @map("updated_at")

  organization Organization @relation(fields: [organizationId], references: [id])
  kanban       Kanban?      @relation(fields: [kanbanId], references: [id], onDelete: Restrict)

  @@index([organizationId, state])
  @@map("kanban_revision")
}
