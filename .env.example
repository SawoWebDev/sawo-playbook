# Copy to .env and override. Never commit real secrets.

# --- required for docker-compose.prod.yml ---
POSTGRES_PASSWORD=change-me
JWT_ACCESS_SECRET=change-me-to-a-long-random-string
# Encrypts TOTP secrets at rest. Changing it invalidates every enrolled authenticator.
MFA_ENCRYPTION_KEY=change-me-to-another-long-random-string
S3_ACCESS_KEY=gemba
S3_SECRET_KEY=change-me-minio-secret
PUBLIC_APP_URL=https://sop.example.com
S3_PUBLIC_ENDPOINT=https://media.example.com
SMTP_URL=smtps://user:password@smtp.example.com:465
MAIL_FROM=GembaDocs <no-reply@example.com>

# --- optional ---
COOKIE_SECURE=true
# Retention windows (days) for the maintenance worker
TENANT_PURGE_RETENTION_DAYS=30
AUDIT_RETENTION_DAYS=2555
MEDIA_ORPHAN_GRACE_DAYS=7
MEDIA_SOFT_DELETE_RETENTION_DAYS=30
MAINTENANCE_INTERVAL_MS=3600000

# --- local dev (docker-compose.yml) host port overrides ---
# GEMBA_WEB_PORT=3000
# GEMBA_API_PORT=4000
# GEMBA_DB_PORT=5432
# GEMBA_REDIS_PORT=6379
# GEMBA_MINIO_PORT=9000
# GEMBA_PDF_PORT=3001
